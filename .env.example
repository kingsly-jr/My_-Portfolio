# ==============================================================================
# Portfolio Environment Variables
# Copy this file to .env.local and configure your credentials.
# ==============================================================================

# Gmail SMTP Authentication (Required for contact form)
# Generate a 16-character App Password in your Google Account:
# Security -> 2-Step Verification -> App passwords
GMAIL_APP_PASSWORD=your_16_character_app_password

# Email Routing (Optional - configure your email addresses)
CONTACT_SENDER_EMAIL=your_email@gmail.com
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# Google Analytics 4 Measurement ID (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
